# Environment Configuration
ENVIRONMENT=local

# API Keys (Required for AI analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# AI Configuration
AI_MODEL=claude-sonnet-4-5-20250929
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# Scraper Configuration
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT=30
SCRAPER_RATE_LIMIT=1.0

# Storage Configuration
STORAGE_BACKEND=sqlite
DATA_DIR=./data
CACHE_ENABLED=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database (if using PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/leads_scraper

# AWS Configuration (if deploying to AWS)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET=leads-scraper-data

# Azure Configuration (if deploying to Azure)
# AZURE_STORAGE_ACCOUNT=your_storage_account
# AZURE_STORAGE_KEY=your_storage_key
# AZURE_CONTAINER=leads-scraper-data
